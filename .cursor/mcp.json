{
  "mcpServers": {
    "ast-index": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}\\.ast-index\\bin\\ast-index-mcp.js"
      ],
      "env": {
        "AST_INDEX_ROOT": "${workspaceFolder}",
        "AST_INDEX_BIN": "${workspaceFolder}\\.ast-index\\bin\\ast-index.exe",
        "AST_INDEX_DB_PATH": "${workspaceFolder}\\.ast-index\\index.db"
      }
    }
  }
}
